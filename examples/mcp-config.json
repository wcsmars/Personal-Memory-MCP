{
  "mcpServers": {
    "personal-memory": {
      "command": "/ABSOLUTE/PATH/TO/Personal-Memory-MCP/.venv/bin/python",
      "args": ["-m", "personal_memory.server"],
      "env": {
        "PYTHONPATH": "/ABSOLUTE/PATH/TO/Personal-Memory-MCP/src",
        "MEMORY_DB": "/ABSOLUTE/PATH/TO/Personal-Memory-MCP/local/memory.db",
        "MEMORY_NAMESPACE": "personal",
        "MEMORY_VECTOR_BACKEND": "auto",
        "MEMORY_ENABLE_WRITES": "false"
      }
    }
  }
}
